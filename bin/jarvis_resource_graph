#!/usr/bin/env python3
"""
Resource graph collection binary for Jarvis.
Collects storage device information and performance metrics for the current machine.
The collector lives in :mod:`jarvis_cd.core.rg_collector`.
"""
import sys
from pathlib import Path

# Allow running from a source checkout without installing.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from jarvis_cd.core.rg_collector import main

if __name__ == '__main__':
    main()
